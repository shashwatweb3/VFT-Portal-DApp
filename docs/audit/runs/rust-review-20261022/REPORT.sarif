{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "rust-review",
          "informationUri": "https://github.com/trailofbits/skills/tree/main/plugins/rust-review",
          "rules": [
            {
              "id": "arithmetic-overflow",
              "shortDescription": {
                "text": "Integer overflow on an attacker-reachable path"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "assertion-reachable",
              "shortDescription": {
                "text": "Attacker-reachable assert! or unreachable! panic"
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "cancel-safety",
              "shortDescription": {
                "text": "Cancellation-unsafe .await sequence"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "cargo-lint-config",
              "shortDescription": {
                "text": "Cargo lint config weakens safety checks"
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "msrv-mismatch",
              "shortDescription": {
                "text": "MSRV or edition mismatch with APIs in use"
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "resource-exhaustion",
              "shortDescription": {
                "text": "CPU or memory exhaustion DoS on untrusted input"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "result-discarded",
              "shortDescription": {
                "text": "Security-relevant Result discarded without handling"
              },
              "defaultConfiguration": {
                "level": "note"
              }
            },
            {
              "id": "string-comparison",
              "shortDescription": {
                "text": "Partial or case-insensitive string comparison bypasses a check"
              },
              "defaultConfiguration": {
                "level": "note"
              }
            }
          ]
        }
      },
      "originalUriBaseIds": {
        "%SRCROOT%": {
          "description": {
            "text": "Root of the audited Rust crate or workspace; finding URIs are relative to this."
          }
        }
      },
      "invocations": [
        {
          "executionSuccessful": true,
          "properties": {
            "threat_model": "REMOTE",
            "severity_filter": "all",
            "skipped_findings": 0
          }
        }
      ],
      "results": [
        {
          "ruleId": "arithmetic-overflow",
          "level": "error",
          "message": {
