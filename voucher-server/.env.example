# Vara RPC (local dev node: ws://127.0.0.1:9944)
NODE_ADDRESS=ws://127.0.0.1:9944
# Launchpad program the vouchers are scoped to
LAUNCHPAD_ADDRESS=
# Hot wallet that pays for vouchers (fund it; keep it small). Never commit a real seed.
ISSUER_SEED=//Alice
# Hot wallet that sends Graduate/Unwind; use a different account from the issuer (nonces)
KEEPER_SEED=//Bob
# Gas a sponsored Launch may use; the voucher is sized as LAUNCH_GAS x the chain's value-per-gas + 10 %.
# Lifetime in blocks (~3 s blocks; 28800 ≈ 1 day).
LAUNCH_GAS=120000000000
VOUCHER_DURATION_BLOCKS=600
# One voucher per address per this many hours
RATE_LIMIT_HOURS=24
# Comma-separated origins allowed to call POST /voucher
ALLOWED_ORIGINS=http://localhost:3000
PORT=4010
KEEPER_INTERVAL_MS=6000
# Where issued-voucher records are persisted
STATE_FILE=./voucher-state.json
# Abuse caps
PER_IP_PER_HOUR=3
GLOBAL_PER_HOUR=120
ISSUER_FLOOR_VARA=200
# Set true only behind a proxy that sets X-Forwarded-For
TRUST_PROXY=false
